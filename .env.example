# Copy to .env for local development. Never commit the real .env.
# In production these values come from AWS Parameter Store (see fetch-secrets.sh).

# Django
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: False uses SQLite with runserver; docker-compose switches to Postgres
USE_POSTGRES=False
DB_NAME=portfolio_db
DB_USER=portfolio_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Production only 
# ENABLE_ADMIN=False
# TUNNEL_MODE=False
# CSRF_TRUSTED_ORIGINS=https://d1234abcd.cloudfront.net
# MEDIA_BUCKET=your-media-bucket
# CLOUDFRONT_DOMAIN=d1234abcd.cloudfront.net
# AWS_REGION=eu-west-2

# docker-compose also needs a .env.db file:
# POSTGRES_DB=portfolio_db
# POSTGRES_USER=portfolio_app
# POSTGRES_PASSWORD=change-me   (must match DB_PASSWORD)